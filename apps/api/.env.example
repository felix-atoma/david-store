# Local Postgres 18 (same setup as G|K Ventures)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/david_store?schema=public"

PORT=3000
NODE_ENV=development
# Comma-separated origins allowed to call the API (storefront, admin)
CORS_ORIGINS=http://localhost:5173,http://localhost:5174
# Public storefront URL: used in Hubtel return links, share previews and the sitemap
STOREFRONT_URL=http://localhost:5173
# This API's public URL: Hubtel posts payment callbacks here
API_PUBLIC_URL=http://localhost:3000

# Long random strings, e.g. node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=change-me
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_DAYS=30

# Hubtel Online Checkout (Hubtel dashboard > API keys). POS Sales ID = merchant account number.
HUBTEL_API_ID=
HUBTEL_API_KEY=
HUBTEL_MERCHANT_ACCOUNT=

# First super admin, created by `pnpm db:seed`. Leave the password empty to get a random one printed.
SEED_ADMIN_EMAIL=
SEED_ADMIN_NAME=David
SEED_ADMIN_PASSWORD=
