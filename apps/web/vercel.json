{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://david-store-api.onrender.com/api/:path*"
    },
    {
      "source": "/sitemap.xml",
      "destination": "https://david-store-api.onrender.com/api/seo/sitemap.xml"
    },
    {
      "source": "/robots.txt",
      "destination": "https://david-store-api.onrender.com/api/seo/robots.txt"
    },
    {
      "source": "/p/:slug",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": "(?i).*(facebookexternalhit|whatsapp|twitterbot|linkedinbot|slackbot|telegrambot|discordbot|googlebot|bingbot).*"
        }
      ],
      "destination": "https://david-store-api.onrender.com/api/seo/p/:slug"
    },
    {
      "source": "/c/:slug",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": "(?i).*(facebookexternalhit|whatsapp|twitterbot|linkedinbot|slackbot|telegrambot|discordbot|googlebot|bingbot).*"
        }
      ],
      "destination": "https://david-store-api.onrender.com/api/seo/c/:slug"
    },
    {
      "source": "/((?!assets/|products/|icon.svg|logo.svg|og-image.png|favicon-32.png|apple-touch-icon.png|pwa-|manifest.webmanifest|sw.js|workbox-).*)",
      "destination": "/index.html"
    }
  ]
}
